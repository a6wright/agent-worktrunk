// Tab layout for a worktree: full-height left pane, right side split top/bottom,
// with a one-line pane named "keys" under those: shell/workflow.zsh sees the
// name and shows the key strip (wt-keys) in it.
// The tab name and cwd are supplied by `wts` via `zellij action new-tab --name/--cwd`.
//
// The bars are repeated here because `new-tab --layout` does not inherit the
// session's default_tab_template.
layout {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane split_direction="vertical" {
        pane size="50%" focus=true
        pane split_direction="horizontal" {
            pane
            pane
            pane size=1 name="keys" borderless=true
        }
    }
    pane size=1 borderless=true {
        plugin location="status-bar"
    }
}
