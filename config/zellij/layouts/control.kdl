// Session layout: one tab named "control", split top/bottom. The top pane is a
// plain shell and has focus; the bottom one is named "hub", which is how
// shell/workflow.zsh knows to start the hub in it.
// Worktree tabs are added later by `wts` using layouts/worktree.kdl.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }
    tab name="control" focus=true {
        pane split_direction="horizontal" {
            pane size="50%" focus=true
            pane name="hub"
        }
    }
}
