// Session layout: one tab named "control" with a single pane. That pane is
// zellij's pane 0, which is how shell/workflow.zsh knows to start the hub in it.
// Worktree tabs are added later by `wts` using layouts/worktree.kdl.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }
    tab name="control" focus=true {
        pane
    }
}
