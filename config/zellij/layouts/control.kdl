// Session layout: one tab named "control" with a single pane.
// Worktree tabs are added later by `wts` using layouts/worktree.kdl.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="status-bar"
        }
    }
    tab name="control" focus=true {
        pane
    }
}
