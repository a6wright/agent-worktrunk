// Partial config: zellij merges this over its defaults, so only overrides live here.
// See `zellij setup --dump-config` for everything that can be set.

// New sessions start with a single "control" tab (layouts/control.kdl).
default_layout "control"

// Sessions are saved to disk so `zellij attach -c main` can resurrect them after a reboot.
// This is zellij's default; stated so the workflow does not silently depend on it.
session_serialization true

show_startup_tips false
show_release_notes false

keybinds {
    shared_except "locked" {
        // Floating panes covering 95% of the screen, opened in the focused
        // pane's directory. One of each per tab: pressing the key again closes it.
        // lazygit, with Esc to quit (config/lazygit/float.yml).
        bind "Alt g" {
            Run "wt-float" "wt-lazygit" {
                floating true
                close_on_exit true
            }
        }
        // The repo's markdown, picked with fzf, rendered with Mermaid diagrams.
        bind "Alt m" {
            Run "wt-float" "wt-md" {
                floating true
                close_on_exit true
            }
        }
    }
}
