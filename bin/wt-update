#!/usr/bin/env bash
# Update the workflow on this machine: pull the repo, install whatever is new,
# and restart the zellij session with the same tabs open.
#
# Usage: wt-update [--dry-run] [--no-tools] [--no-restart] [-y]
#        ./update  (from the repo)
#
#   --dry-run     show what would happen: commits to pull, install steps, tabs
#   --no-tools    install.sh links configs and scripts only
#   --no-restart  pull and install, leave the session alone
#   -y            do not ask before restarting
#
# The restart kills the session, so everything running in its panes stops
# (agents included; `claude --resume` gets a conversation back). It then creates
# the session again from a layout built on the spot: the control layout plus
# one worktree-layout tab per tab that was open, in the same directory and
# under the same name. Terminals that were attached rejoin on their own
# (shell/workflow.zsh waits for the marker this leaves in the state dir).
# Zellij reloads its config on the fly, so a restart matters for a new zellij,
# a changed layout, or to give open tabs the current layout.
set -euo pipefail

# The repo, through the symlinks `~/.local/bin/wt-update` and `./update`.
self=${BASH_SOURCE[0]}
while [[ -L $self ]]; do
    target=$(readlink "$self")
    [[ $target == /* ]] || target=$(dirname "$self")/$target
    self=$target
done
REPO=$(cd "$(dirname "$self")/.." && pwd -P)
# shellcheck source=lib.sh
source "$REPO/lib.sh"

SESSION=${WORKFLOW_SESSION:-main}
PLAN=$STATE_DIR/tabs.tsv
LOG=$STATE_DIR/update.log
MARKER=$STATE_DIR/restarting
LAYOUT=$STATE_DIR/restart-layout.kdl

ASSUME_YES=0 RESTART=1 INSTALL_ARGS=()
for arg in "$@"; do
    case $arg in
        --dry-run) DRY_RUN=1; INSTALL_ARGS+=(--dry-run) ;;
        --no-tools) INSTALL_ARGS+=(--no-tools) ;;
        --no-restart) RESTART=0 ;;
        -y) ASSUME_YES=1 ;;
        --worker) exec_worker=1 ;;
        -h | --help)
            sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p;}' "$0"
            exit 0
            ;;
        *) die "unknown option: $arg (try --help)" ;;
    esac
done

# Run zellij against the session from anywhere, inside it or not.
z() { zellij --session "$SESSION" "$@"; }

session_state() { # running | dead | none
    local line
    line=$(zellij list-sessions --no-formatting 2>/dev/null | awk -v s="$SESSION" '$1 == s') || true
    if [[ -z $line ]]; then echo none
    elif [[ $line == *EXITED* ]]; then echo dead
    else echo running
    fi
}

# --- the tabs to reopen ---------------------------------------------------------
# One line per tab, in order: position, name, kind (wt|plain), cwd, branch.
# A tab is a worktree's when its panes sit in a git worktree; the control tab
# is skipped because the new session starts with one.
tab_plan() {
    z action list-panes --json 2>/dev/null |
        jq -r '
            [ .[] | select((.is_plugin | not) and (.is_floating | not) and .tab_name != "control")
              | {pos: .tab_position, name: .tab_name, cwd: (.pane_cwd // "")} ]
            | group_by(.pos) | map(first) | sort_by(.pos)[]
            | "\(.pos)\t\(.name)\t\(.cwd)"' |
        while IFS=$'\t' read -r pos name cwd; do
            if [[ -d $cwd ]] && root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null); then
                branch=$(git -C "$root" branch --show-current 2>/dev/null)
                printf '%s\t%s\twt\t%s\t%s\n' "$pos" "$name" "$root" "${branch:-$name}"
            else
                printf '%s\t%s\tplain\t%s\t\n' "$pos" "$name" "${cwd:-$HOME}"
            fi
        done
}

show_plan() {
    local pos name kind cwd branch
    while IFS=$'\t' read -r pos name kind cwd branch; do
        if [[ $kind == wt ]]; then
            printf '    %-24s %s  (%s)\n' "$name" "$(tilde "$cwd")" "$branch"
        else
            printf '    %-24s %s\n' "$name" "$(tilde "$cwd")"
        fi
    done <"$1"
}

# --- the session layout ------------------------------------------------------------
# The tabs go into the layout the new session is created from, not through
# `zellij action new-tab` afterwards: a tab added to a session with no client
# attached leaves it in a state no client can attach to (zellij 0.45), and at
# that point nothing is attached, the old session having just been killed.
layout_dir() { echo "${ZELLIJ_CONFIG_DIR:-$CONFIG_HOME/zellij}/layouts"; }

# A layout file by name or path; the repo's copy when it is not installed.
layout_file() {
    local layout=$1 file
    [[ $layout == */* ]] && { echo "$layout"; return; }
    for file in "$(layout_dir)/$layout.kdl" "$REPO/config/zellij/layouts/$layout.kdl"; do
        [[ -f $file ]] && { echo "$file"; return; }
    done
    return 1
}

# What is inside `layout { ... }`, comments dropped. With nobars=1 the tab-bar
# and status-bar panes go too: the control layout's tab template supplies them
# for every tab (layouts/worktree.kdl repeats them only for `new-tab --layout`).
layout_body() {
    awk -v nobars="${2:-0}" '
        /^[[:space:]]*\/\// { next }
        !opened && /^[[:space:]]*layout[[:space:]]*[{]/ { opened = 1; next }
        nobars && /^[[:space:]]*pane size=1 borderless=true [{]/ { buf = $0; inpane = 1; next }
        inpane {
            buf = buf "\n" $0
            if ($0 ~ /^[[:space:]]*[}]/) {
                inpane = 0
                if (buf !~ /plugin location="(tab-bar|status-bar|compact-bar)"/) lines[n++] = buf
            }
            next
        }
        { lines[n++] = $0 }
        END {
            while (n > 0 && lines[n-1] ~ /^[[:space:]]*$/) n--
            if (n > 0 && lines[n-1] ~ /^[}][[:space:]]*$/) n--
            for (i = 0; i < n; i++) print lines[i]
        }' "$1"
}

kdl_string() { local s=${1//\\/\\\\}; printf '"%s"' "${s//\"/\\\"}"; }

# The session's default layout, from zellij's config; "control" when unset.
control_layout_name() {
    local config=${ZELLIJ_CONFIG_FILE:-${ZELLIJ_CONFIG_DIR:-$CONFIG_HOME/zellij}/config.kdl} name
    name=$(sed -n 's/^[[:space:]]*default_layout[[:space:]]*"\([^"]*\)".*/\1/p' "$config" 2>/dev/null | head -1)
    echo "${name:-control}"
}

# The layout for the new session: the control layout as installed, then a tab
# per line of the plan. Plain folders get the worktree layout too, as the hub
# gives them.
write_layout() {
    local control worktree body pos name kind cwd branch
    control=$(layout_file "$(control_layout_name)") || { echo "no control layout"; return 1; }
    worktree=$(layout_file "${WTS_LAYOUT:-worktree}") || { echo "no worktree layout"; return 1; }
    body=$(layout_body "$worktree" 1 | sed 's/^/    /')
    {
        echo "layout {"
        layout_body "$control"
        while IFS=$'\t' read -r pos name kind cwd branch; do
            printf '    tab name=%s cwd=%s {\n' "$(kdl_string "$name")" "$(kdl_string "$cwd")"
            echo "$body"
            echo "    }"
        done <"$PLAN"
        echo "}"
    } >"$LAYOUT"
}

# --- the worker: outlives the pane this ran from -------------------------------------
worker() {
    local name active
    echo "== $(date) restarting $SESSION"
    # Started from a pane of the session it restarts, so it inherits that
    # session's variables; with them set, zellij refuses to attach to "itself".
    unset ZELLIJ ZELLIJ_SESSION_NAME ZELLIJ_PANE_ID
    # Whatever happens, the marker goes: terminals wait on it to rejoin.
    trap 'rm -f "$MARKER"' EXIT
    touch "$MARKER"
    write_layout || return 1
    while IFS=$'\t' read -r _ name _; do echo "tab $name"; done <"$PLAN"
    active=$(z action current-tab-info --json 2>/dev/null | jq -r '.name // empty') || true
    zellij kill-session "$SESSION" || true
    for _ in $(seq 1 50); do
        [[ $(session_state) == running ]] || break
        sleep 0.2
    done
    zellij delete-session --force "$SESSION" 2>/dev/null || true
    zellij attach --create-background "$SESSION" options --default-layout "$LAYOUT"
    for _ in $(seq 1 100); do
        [[ $(session_state) == running ]] && break
        sleep 0.2
    done
    [[ $(session_state) == running ]] || { echo "session did not come up"; return 1; }
    sleep 1
    [[ -n $active ]] && z action go-to-tab-name "$active" 2>/dev/null || true
    echo "done"
}

if [[ ${exec_worker:-0} == 1 ]]; then
    worker
    exit
fi

# --- main -------------------------------------------------------------------------
((DRY_RUN)) && note "dry run: nothing will be changed"
rm -f "$MARKER"

headline "Repo"
if git -C "$REPO" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    step "fetching"
    git -C "$REPO" fetch --quiet
    behind=$(git -C "$REPO" rev-list --count 'HEAD..@{upstream}')
    if ((behind == 0)); then
        ok "up to date ($(git -C "$REPO" log -1 --format=%h))"
    elif ((DRY_RUN)); then
        would "pull $behind commit(s):"
        git -C "$REPO" log --oneline 'HEAD..@{upstream}' | sed 's/^/       /'
    else
        step "pulling $behind commit(s)"
        git -C "$REPO" pull --ff-only --quiet ||
            die "pull failed: local changes or history in $(tilde "$REPO")? Resolve, then re-run."
        git -C "$REPO" log --oneline "HEAD@{1}..HEAD" | sed 's/^/     /'
    fi
else
    note "no upstream configured for $(tilde "$REPO"); skipping pull"
fi

"$REPO/install.sh" ${INSTALL_ARGS[@]+"${INSTALL_ARGS[@]}"}

((RESTART)) || exit 0
headline "Session"
case $(session_state) in
    none | dead)
        note "no \"$SESSION\" session running; open a terminal to start one"
        exit 0
        ;;
esac
mkdir -p "$STATE_DIR"
tab_plan >"$PLAN"
if [[ -s $PLAN ]]; then
    echo "  tabs to reopen:"
    show_plan "$PLAN"
else
    echo "  no tabs besides control"
fi
if ((DRY_RUN)); then
    would "restart the session and reopen those tabs"
    exit 0
fi
if ! ((ASSUME_YES)); then
    read -r -p "  Restart zellij? Everything running in its panes stops. [Y/n] " answer </dev/tty || answer=n
    [[ -z $answer || $answer == [Yy]* ]] || { note "left the session alone"; exit 0; }
fi
step "restarting; log: $(tilde "$LOG")"
if [[ -n ${ZELLIJ:-} ]]; then
    echo "  this pane goes away with the session; the terminal rejoins when the new one is up"
fi
# Detached, so it survives its own pane being killed. setsid where there is
# one (Linux); nohup on macOS.
if have setsid; then
    setsid -f bash "$0" --worker >>"$LOG" 2>&1 </dev/null
else
    nohup bash "$0" --worker >>"$LOG" 2>&1 </dev/null &
    disown
fi
