#!/usr/bin/env bash
# lazygit for the Alt g pane: your own lazygit config, with config/lazygit/float.yml
# from this repo layered over it so that Esc (with no popup open) quits.
#
# Usage: wt-lazygit [lazygit args...]
set -euo pipefail

case ${1:-} in
    -h | --help)
        sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p;}' "$0"
        exit 0
        ;;
esac

# This runs through a link in ~/.local/bin; the overlay sits in the repo.
repo=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
overlay=$repo/config/lazygit/float.yml

# LG_CONFIG_FILE replaces lazygit's default config file, so name that too.
base=${LG_CONFIG_FILE:-$(lazygit --print-config-dir)/config.yml}
if [[ -n ${LG_CONFIG_FILE:-} || -f $base ]]; then
    export LG_CONFIG_FILE=$base,$overlay
else
    export LG_CONFIG_FILE=$overlay
fi
exec lazygit "$@"
