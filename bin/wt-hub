#!/usr/bin/env bash
# Everything you are working on, on one screen: each git project under
# ~/workspace with its worktrees, whether a tab is open for it, how far it has
# drifted, and its last commit; plain folders too. Pick one to open (or jump
# to) its tab.
#
# Usage: wt-hub [--list]
#
#   --list   print the table and exit, no picker
#
# In the picker:
#   type     filter by project, branch or last commit
#   enter    open the worktree's (or folder's) tab, or jump to it if it is open
#   space    new worktree in the highlighted project (asks for the branch)
#   ctrl-x   same as space
#   tab      the highlighted project's branches, local and remote, newest first;
#            pick one to open a worktree for it (for reviewing someone's work)
#   ctrl-r   refresh
#   esc      quit
#
# Projects are the git repositories directly under WORKFLOW_ROOT (default
# ~/workspace; colon-separated for several). Their worktrees are found through
# worktrunk, so those can live anywhere. A folder there that is not a git
# repository is listed as well; enter opens a tab in it.
set -euo pipefail

die() {
    echo "wt-hub: $*" >&2
    exit 1
}

# --- rows -------------------------------------------------------------------------
# One tab-separated line per worktree, plus a header line first:
#   kind (wt|none|dir)  path  branch  project-path  display
# fzf shows only the last field; the others are what an action needs.

# shellcheck disable=SC2016  # jq program, $vars are jq's
fmt='
def pad(n):  tostring | . + ([range(n - length)] | map(" ") | join(""));
def rpad(n): tostring | ([range(n - length)] | map(" ") | join("")) + .;
def dim:   "[2m\(.)[22m";
def bold:  "[1m\(.)[22m";
def green: "[32m\(.)[39m";
def yellow: "[33m\(.)[39m";
def red:   "[31m\(.)[39m";
def age:
    if . == null then "" else
        (now - fromdateiso8601) as $s
        | if   $s < 3600            then "\($s / 60 | floor)m"
          elif $s < 86400           then "\($s / 3600 | floor)h"
          elif $s < 86400 * 14      then "\($s / 86400 | floor)d"
          elif $s < 86400 * 365     then "\($s / 604800 | floor)w"
          else                           "\($s / 31536000 | floor)y" end
    end;
def status:
    (.worktree.changes // {}) as $c
    | [ (if ($c.diff.added // 0) + ($c.diff.deleted // 0) > 0
           then "+\($c.diff.added) -\($c.diff.deleted)"
         elif ($c.staged or $c.modified or $c.deleted or $c.renamed) then "*"
         else empty end),
        (if $c.untracked then "?" else empty end),
        (if $c.conflicted then "conflict" else empty end),
        (if (.upstream.ahead // 0) > 0 then "↑\(.upstream.ahead)" else empty end),
        (if (.upstream.behind // 0) > 0 then "↓\(.upstream.behind)" else empty end)
      ] | join(" ");

# Directories the terminal panes are sitting in right now.
($panes[0] // [] | map(select(.is_plugin | not) | .pane_cwd // empty)) as $cwds
| def open($p): any($cwds[]; . == $p or startswith($p + "/"));

[ sort_by(.project | ascii_downcase)[]
  | .project as $project
  | ($project | split("/") | last) as $name
  | (.items | sort_by((.worktree.main | not), .branch)) as $items
  | if .dir then
        { kind: "dir", path: $project, branch: "", project: $project,
          name: $name, open: open($project), age: "", status: "", subject: "folder" }
    elif ($items | length) == 0 then
        { kind: "none", path: $project, branch: "-", project: $project,
          name: $name, open: false, age: "", status: "", subject: "no worktrees" }
    else
        $items | to_entries[] | .value as $it
        | { kind: "wt", path: $it.worktree.path,
            branch: ($it.branch // "(\($it.head.short_sha // "detached"))"),
            project: $project,
            name: (if .key == 0 then $name else "" end),
            open: open($it.worktree.path),
            age: ($it.head.committed_at | age),
            status: ($it | status),
            subject: ($it.head.subject // "") }
    end
]
| ([7] + map(.name   | length) | max) as $wn
| ([6] + map(.branch | length) | max) as $wb
| ([6] + map(.status | length) | max) as $ws
| ( ["", "", "", "",
      (("PROJECT" | pad($wn)) + "  " + ("BRANCH" | pad($wb)) + "     " + ("AGE" | rpad(3))
       + "  " + ("STATUS" | pad($ws)) + "  LAST COMMIT" | dim)]
  , (.[] | [ .kind, .path, .branch, .project,
      (.name | pad($wn) | bold) + "  "
      + (.branch | pad($wb)) + "  "
      + (if .open then ("●" | green) else " " end) + "  "
      + (.age | rpad(3) | dim) + "  "
      + (.status | pad($ws) | if test("conflict") then red elif . != "" then yellow else . end) + "  "
      + (.subject[:60] | dim) ]))
| @tsv
'

rows() {
    local tmp root d i=0
    tmp=$(mktemp -d)
    IFS=: read -r -a roots <<<"${WORKFLOW_ROOT:-$HOME/workspace}"
    for root in "${roots[@]}"; do
        for d in "${root%/}"/*/; do
            d=${d%/}
            i=$((i + 1))
            # A .git *file* marks a linked worktree; it shows up under its project.
            if [[ -f $d/.git ]]; then
                i=$((i - 1))
            elif [[ -d $d/.git ]]; then
                (
                    cd "$d" && { wt list --format json 2>/dev/null || echo '{}'; } |
                        jq --arg project "$d" '{project: $project, items: (.items // [])}'
                ) >"$tmp/$i.json" 2>/dev/null &
            else
                jq -n --arg project "$d" '{project: $project, items: [], dir: true}' >"$tmp/$i.json"
            fi
        done
    done
    wait
    if ((i == 0)); then
        rm -rf "$tmp"
        die "nothing under ${WORKFLOW_ROOT:-$HOME/workspace} (set WORKFLOW_ROOT)"
    fi
    if [[ -n ${ZELLIJ:-} ]]; then
        zellij action list-panes --tab --command --json >"$tmp/panes.json" 2>/dev/null || echo '[]' >"$tmp/panes.json"
    else
        echo '[]' >"$tmp/panes.json"
    fi
    jq -r -s --slurpfile panes "$tmp/panes.json" "$fmt" "$tmp"/[0-9]*.json
    rm -rf "$tmp"
}

preview() {
    local p=$1
    [[ -d $p ]] || { echo "missing: $p"; return 0; }
    if ! git -C "$p" rev-parse --git-dir >/dev/null 2>&1; then
        # shellcheck disable=SC2012  # a listing for the eye, not for parsing
        ls -Ap1 "$p" | head -40
        return 0
    fi
    git -C "$p" -c color.status=always status --short --branch 2>&1 | head -30
    echo
    git -C "$p" log --color=always --oneline --decorate -15 2>&1
}

# --- branches ---------------------------------------------------------------------
# One tab-separated line per branch of a project, plus a header line first:
#   name  ref  display
# `name` is what `wt switch` takes; `ref` is what git log takes (origin/x for a
# branch that only exists on the remote). A remote branch with a local
# counterpart is folded into it. Fetches first so a colleague's new branch shows
# up, but does not wait long for it.

branch_rows() {
    local p=$1
    [[ -d $p ]] || die "missing: $p"
    if command -v timeout >/dev/null; then
        timeout 8 git -C "$p" fetch --quiet --prune --all 2>/dev/null || true
    else
        git -C "$p" fetch --quiet --prune --all 2>/dev/null || true
    fi
    git -C "$p" for-each-ref --sort=-committerdate \
        --format='%(refname:short)%09%(refname)%09%(committerdate:unix)%09%(authorname)%09%(subject)%09%(worktreepath)' \
        refs/heads refs/remotes |
        awk -F '\t' -v now="$(date +%s)" -v project="$p" '
            function age(t,  s) {
                if (t == "") return ""
                s = now - t
                if (s < 3600)         return int(s / 60) "m"
                if (s < 86400)        return int(s / 3600) "h"
                if (s < 86400 * 14)   return int(s / 86400) "d"
                if (s < 86400 * 365)  return int(s / 604800) "w"
                return int(s / 31536000) "y"
            }
            function pad(str, n) { return sprintf("%-" n "s", str) }
            function max(a, b) { return a > b ? a : b }
            {
                short = $1; ref = $2
                if (ref ~ /^refs\/heads\//) {
                    name = short; local[name] = 1
                    where = ($6 == "") ? "" : ($6 == project ? "main" : "wt")
                    wtpath[name] = $6
                } else {
                    if (ref ~ /\/HEAD$/) next
                    name = short; sub(/^[^\/]+\//, "", name)
                    if (name in local || name in remote) next
                    remote[name] = 1
                    where = substr(short, 1, index(short, "/") - 1)
                }
                n++
                N[n] = name; R[n] = short; W[n] = where; A[n] = age($3); U[n] = $4; S[n] = $5
                wn = max(wn, length(name)); ww = max(ww, length(where)); wu = max(wu, length($4))
            }
            END {
                wn = max(wn, 6); ww = max(ww, 5); wu = max(wu, 6)
                printf "\t\t\033[2m%s  %s  AGE  %s  LAST COMMIT\033[22m\n", pad("BRANCH", wn), pad("WHERE", ww), pad("AUTHOR", wu)
                for (i = 1; i <= n; i++) {
                    w = W[i]
                    if (w == "wt" || w == "main") w = "\033[32m" pad(w, ww) "\033[39m"
                    else if (w == "")             w = pad(w, ww)
                    else                          w = "\033[2m" pad(w, ww) "\033[22m"
                    printf "%s\t%s\t\033[1m%s\033[22m  %s  \033[2m%3s\033[22m  %s  \033[2m%s\033[22m\n",
                        N[i], R[i], pad(N[i], wn), w, A[i], pad(U[i], wu), substr(S[i], 1, 60)
                }
            }'
}

branch_preview() {
    local p=$1 ref=$2
    git -C "$p" log --color=always --oneline --decorate -20 "$ref" 2>&1
}

# Prints the chosen branch name, or nothing when the picker was dismissed.
branch_pick() {
    local p=$1
    branch_rows "$p" | fzf --ansi --delimiter $'\t' --with-nth 3 --accept-nth 1 \
        --header-lines 1 --layout reverse --no-sort --cycle \
        --prompt "${p##*/} branches > " --info inline-right \
        --header 'enter open worktree · ctrl-r fetch again · esc back' \
        --bind "ctrl-r:reload('$0' --branch-rows '$p')" \
        --preview "'$0' --branch-preview '$p' {2}" --preview-window 'right,50%,border-left'
}

# A tab for a plain folder, named after it, with the worktree layout (shells in
# the folder plus the key strip). Jumps to the tab if one is open in it.
open_dir() {
    local p=$1 name=${1##*/} layout
    if zellij action query-tab-names | grep -Fxq -- "$name" \
        && zellij action list-panes --tab --json | jq -e --arg tab "$name" --arg p "$p" '
            any(.[]; (.is_plugin | not) and .tab_name == $tab
                     and (.pane_cwd // "" | . == $p or startswith($p + "/")))' >/dev/null; then
        zellij action go-to-tab-name "$name"
        return
    fi
    layout=${WTS_LAYOUT:-worktree}
    if [[ $layout != */* ]]; then
        layout_file=${ZELLIJ_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/zellij}/layouts/$layout.kdl
        [[ -f $layout_file ]] && layout=$layout_file
    fi
    zellij action new-tab --layout "$layout" --name "$name" --cwd "$p" >/dev/null
}

# Open (creating if needed) a worktree for a branch of a project, in its own tab.
# Same rule as wts: --create only for a plain branch name that exists nowhere
# yet; shortcuts, pr:N refs, URLs and paths go through untouched.
open_branch() {
    local project=$1 name=$2 create=()
    if [[ $name != -* && $name != [@^-] && $name != pr:* && $name != mr:* \
          && $name != *://* && ! -d $name ]] \
        && ! git -C "$project" show-ref --verify --quiet "refs/heads/$name" \
        && [[ -z $(git -C "$project" for-each-ref --count=1 "refs/remotes/*/$name") ]]; then
        create=(--create)
    fi
    (cd "$project" && wt switch ${create[@]+"${create[@]}"} "$name" --no-cd \
        -x wts-open-tab -- '{{ branch }}' '{{ worktree_path }}')
}

# --- picker -----------------------------------------------------------------------

pause() {
    echo
    read -r -p "press enter to continue " </dev/tty || true
}

pick() {
    rows | fzf --ansi --delimiter $'\t' --with-nth 5 \
        --header-lines 1 --layout reverse --no-sort --cycle \
        --prompt 'hub > ' --info inline-right \
        --header 'enter open tab · space new worktree · tab branches · ctrl-r refresh · esc quit' \
        --expect ctrl-x,space,tab \
        --bind "ctrl-r:reload('$0' --rows)" \
        --preview "'$0' --preview {2}" --preview-window 'right,50%,border-left'
}

main() {
    for t in fzf jq wt; do
        command -v "$t" >/dev/null || die "$t not found on PATH"
    done
    [[ -n ${ZELLIJ:-} ]] || die "not inside a zellij session (use --list for the table)"

    local out key sel kind path branch project name
    while out=$(pick); do
        { IFS= read -r key; IFS= read -r sel; } <<<"$out"
        [[ -n $sel ]] || continue
        IFS=$'\t' read -r kind path branch project _ <<<"$sel"
        if [[ $kind == dir ]] && [[ $key == ctrl-x || $key == space || $key == tab ]]; then
            echo
            echo "${path##*/} is a folder, not a git repository: enter opens a tab in it"
            pause
            continue
        fi
        case $key in
            ctrl-x | space)
                echo
                read -r -e -p "new worktree in ${project##*/}, branch name: " name </dev/tty || continue
                [[ -n $name ]] || continue
                open_branch "$project" "$name" || pause
                ;;
            tab)
                name=$(branch_pick "$project") || continue
                [[ -n $name ]] || continue
                open_branch "$project" "$name" || pause
                ;;
            *)
                case $kind in
                    wt) (cd "$path" && wts-open-tab "$branch" "$path") || pause ;;
                    dir) open_dir "$path" || pause ;;
                esac
                ;;
        esac
    done
    echo "hub: run \`hub\` to bring this back"
}

case ${1:-} in
    -h | --help)
        sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p;}' "$0"
        exit 0
        ;;
    --list) rows | cut -f5 ;;
    --rows) rows ;;
    --preview) preview "${2:?path}" ;;
    --branch-rows) branch_rows "${2:?project}" ;;
    --branch-preview) branch_preview "${2:?project}" "${3:?ref}" ;;
    # `exit` inside the case: bash reads a script as it runs, so a `git pull`
    # that rewrites this file while the hub sits in the control tab must not
    # leave anything to read after main returns.
    "") main; exit 0 ;;
    *) die "unknown option: $1 (try --help)" ;;
esac
